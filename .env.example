# Copy to .env.local for local development. Never commit real values;
# set them privately in Vercel (Project → Settings → Environment Variables).

# Stripe secret key (sk_/rk_). Preview must use a *_test_* key.
STRIPE_SECRET_KEY=

# Stripe webhook signing secrets (whsec_...) for /api/stripe/webhook.
STRIPE_CTB_WEBHOOK_SECRET=
STRIPE_CTB_CONNECT_WEBHOOK_SECRET=

# Set to "true" to allow new subscriptions (also needs both webhook secrets).
STRIPE_CTB_BILLING_ENABLED=
# Stripe customer portal configuration ID (bpc_...).
STRIPE_CTB_PORTAL_CONFIGURATION=

# Vercel Blob read/write token for uploads.
BLOB_READ_WRITE_TOKEN=
# Preview only: ID of the separate test Blob store (store_...) that
# BLOB_READ_WRITE_TOKEN must point at, otherwise Preview APIs fail closed.
CTB_TEST_BLOB_STORE_ID=

# Public site origin. Optional, defaults to https://pay.nyttolabs.com.
NEXT_PUBLIC_SITE_URL=

# Resend email for verification codes.
RESEND_API_KEY=
# Optional, defaults to "Curl-to-Buy <onboarding@resend.dev>".
RECOVER_EMAIL_FROM=

# Optional reduced platform fee for one seller email (basis points, 0–500).
CTB_REDUCED_FEE_EMAIL=
CTB_REDUCED_FEE_BPS=
